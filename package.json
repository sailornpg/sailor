{
  "name": "sailor",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI coding workspace built with Electron, AI SDK, and assistant-ui.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "prepare": "husky",
    "preview": "electron-vite preview",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint src tests scripts .agent-harness/scripts electron.vite.config.ts eslint.config.mjs",
    "lint:css": "stylelint 'src/**/*.css'",
    "devtools": "devtools",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.117",
    "@ai-sdk/harness-pi": "1.0.119",
    "@ai-sdk/mcp": "2.0.54",
    "@ai-sdk/react": "4.0.109",
    "@ai-sdk/sandbox-just-bash": "1.0.117",
    "@assistant-ui/ai-sdk": "0.0.7",
    "@assistant-ui/react": "0.15.21",
    "@assistant-ui/react-markdown": "^0.14.16",
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@iconify-json/vscode-icons": "^1.2.79",
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-three/fiber": "9.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.107",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "diff": "^9.0.0",
    "just-bash": "2.14.5",
    "lucide-react": "1.47.0",
    "mammoth": "^1.12.3",
    "node-pty": "1.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.10",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "tw-shimmer": "^0.4.13",
    "unpdf": "^1.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "1.0.22",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.sailor.desktop",
    "productName": "Sailor",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "resources/icon.png"
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "packageManager": "pnpm@11.1.2",
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{css,scss}": [
      "prettier --write",
      "stylelint"
    ],
    "*.{json,md,mdx,html,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
